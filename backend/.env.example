# Model endpoint. Defaults target a local Ollama; any OpenAI-compatible API works.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_TEXT_MODEL=gemma4:12b
# Leave empty to use LLM_TEXT_MODEL for images too.
LLM_VISION_MODEL=
LLM_TEMPERATURE=0
# "none" turns thinking off on local models. Leave empty for models that reject it.
LLM_REASONING_EFFORT=none

# Hides the Pydantic AI observability banner.
PYDANTIC_AI_NO_BANNER=1
