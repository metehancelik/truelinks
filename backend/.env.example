# "openai-compatible" calls a real model. "stub" serves canned answers for the
# bundled sample leases, so the whole app runs with no model at all.
LLM_PROVIDER=openai-compatible

# Model endpoint. Defaults target a local Ollama; any OpenAI-compatible API works.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_TEXT_MODEL=gemma4:12b
# Leave empty to use LLM_TEXT_MODEL for images too.
LLM_VISION_MODEL=
LLM_TEMPERATURE=0
# "none" turns thinking off on local models. Leave empty for models that reject it.
LLM_REASONING_EFFORT=none

# SQLite needs no setup. Docker Compose overrides this with Postgres.
DATABASE_URL=sqlite:///./truelinks.db
